# コンテナ内の HTTP 待ち受けポート。未指定時は8080。
PORT=8080
# 開発用の開始ポート。scripts/dev.py は使用中なら1ずつ増やして起動する。
DEV_PORT=8080
# 1プロセス全体の収集開始回数と同時数。正の整数のみ、再起動時は回数がリセットされる。
MCP_REQUESTS_PER_MINUTE=6
MCP_REQUESTS_PER_DAY=100
MCP_MAX_CONCURRENT=2
# 公開 MCP の HTTPS URL（/tools）。空なら localhost 専用。
# 指定時は認証なしで公開する。許可 Host と既存の収集制限を適用する。
# 公開配置・実接続は未確認。docs/mcp-debug.md を参照する。
MCP_PUBLIC_URL=
